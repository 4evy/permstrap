{
  "files.associations": {
    "*.m": "objective-c",
    "*.mm": "objective-cpp",
    "**/src/application/*.h": "objective-c",
    "**/src/authorization/*.h": "objective-c",
    "**/src/automation/*.h": "objective-c",
    "**/src/permissions/*.h": "objective-c",
    "**/src/policy/*.h": "objective-c",
    "**/src/security/PSTCredentialValidator.h": "c",
